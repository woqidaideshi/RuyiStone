# openRuyi 测试环境变量（plan 通过 environment-file 加载，按实际环境修改）
OPENRUYI_RVA_VARIANT=rva23
OPENRUYI_REPO_BASEURL=https://repo.build.openruyi.cn/openruyi/riscv64/

# ssh 登录实测（HOST 留空默认 localhost；密码/密钥留空则跳过用户登录实测）
SSH_TEST_USER=openruyi
SSH_TEST_HOST=
SSH_TEST_PASSWORD=openruyi
SSH_TEST_KEY=

# podman 镜像导入实测（不配置则跳过）
OPENRUYI_OCI_IMAGE_URL=https://releases.openruyi.cn/creek/2026.09/rva23/openRuyi-2026.09-rootfs-oci.tar

# 其它
SUDO_PASSWORD=openruyi
