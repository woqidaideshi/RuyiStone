# Common metadata for all tests (inherited by child tests)
framework: beakerlib
duration: 5m
enabled: true
contact: openRuyi QA Team <qa@openruyi.cn>

# ------------------------------------------------------------
# Tag vocabulary (keep it small and reusable, avoid inventing new tags)
#   smoke            smoke / P0 cases (filtered by plans/smoke.fmf)
#   feature          feature / P1P2 cases (filtered by plans/feature.fmf)
#   manual           manual cases (inherited by tests/manual/)
#   pkg              package tests (tests/smoke/base_pkgs base package install check)
#   requires-network needs internet (e.g. git clone github / download external images)
# Tiers are expressed with tier: 0/1/2, not tags.
# ------------------------------------------------------------
