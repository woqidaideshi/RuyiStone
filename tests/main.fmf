# 所有测试用例的公共元数据（子测试自动继承）
framework: beakerlib
duration: 5m
enabled: true
contact: openRuyi QA Team <qa@openruyi.cn>

# ------------------------------------------------------------
# tag 词汇表（保持小而可复用，避免为单个用例发明新 tag）
#   smoke            冒烟 / P0 用例（plans/smoke.fmf 过滤）
#   feature          功能 / P1P2 用例（plans/feature.fmf 过滤）
#   manual           手动用例（tests/manual/ 继承）
#   pkg              软件包类测试（tests/smoke/base_pkgs 基础软件安装验证）
#   requires-network 需要外网（如 git clone github / 下载外部镜像）
# 分级另用 tier: 0/1/2 表示，不用 tag 区分。
# ------------------------------------------------------------
